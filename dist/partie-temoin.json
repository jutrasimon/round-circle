  "dialogue": {
    "library": {
      "version": 1,
      "characters": {
        "monsieur": {
          "name": "YOU · THE GENTLEMAN",
          "role": "player",
          "poses": {
            "neutral": "assets/portraits/monsieur-neutral.png",
            "satisfied": "assets/portraits/monsieur-satisfied.png",
            "worried": "assets/portraits/monsieur-worried.png"
          }
        },
        "locataire": {
          "name": "THE TENANT",
          "role": "npc",
          "poses": {
            "neutral": "assets/portraits/locataire-neutral.png",
            "hostile": "assets/portraits/locataire-hostile.png",
            "curious": "assets/portraits/locataire-curious.png"
          }
        }
      },
      "backplates": {
        "default": "assets/ui/backplate.svg"
      },
      "dialogues": [
        {
          "id": "the_line",
          "title": "The Line",
          "start": "arrival",
          "nodes": {
            "arrival": {
              "type": "line",
              "speaker": "locataire",
              "pose": "neutral",
              "backplate": "default",
              "text": "You drew a circle, then wrote “our home” inside it.",
              "next": "reply"
            },
            "reply": {
              "type": "line",
              "speaker": "monsieur",
              "pose": "neutral",
              "backplate": "default",
              "text": "We wanted somewhere to come back to.",
              "next": "answer"
            },
            "answer": {
              "type": "choice",
              "speaker": "monsieur",
              "pose": "worried",
              "backplate": "default",
              "text": "The Tenant looks at you.",
              "choices": [
                {
                  "id": "listen",
                  "text": "Show me what the line cut through.",
                  "next": "listened",
                  "effects": [
                    {
                      "type": "set",
                      "key": "listened",
                      "value": true
                    }
                  ]
                },
                {
                  "id": "claim",
                  "text": "The walls prove this is our home.",
                  "next": "claimed",
                  "effects": [
                    {
                      "type": "add",
                      "key": "tension",
                      "value": 1
                    }
                  ]
                }
              ]
            },
            "listened": {
              "type": "end",
              "speaker": "locataire",
              "pose": "curious",
              "backplate": "default",
              "text": "We wanted to come home too."
            },
            "claimed": {
              "type": "end",
              "speaker": "locataire",
              "pose": "hostile",
              "backplate": "default",
              "text": "A wall only proves you stopped looking behind it."
            }
          }
        },
        {
          "id": "the_passage",
          "title": "The Passage",
          "start": "arrival",
          "nodes": {
            "arrival": {
              "type": "line",
              "speaker": "locataire",
              "pose": "neutral",
              "backplate": "default",
              "text": "Your houses have walls. Ours had passages.",
              "next": "reply"
            },
            "reply": {
              "type": "line",
              "speaker": "monsieur",
              "pose": "worried",
              "backplate": "default",
              "text": "If I open a passage, who protects the people behind me?",
              "next": "answer"
            },
            "answer": {
              "type": "choice",
              "speaker": "monsieur",
              "pose": "worried",
              "backplate": "default",
              "text": "The door stands before you.",
              "choices": [
                {
                  "id": "passage",
                  "text": "Let us keep a passage between us.",
                  "next": "opened",
                  "effects": [
                    {
                      "type": "set",
                      "key": "passage",
                      "value": true
                    }
                  ]
                },
                {
                  "id": "wait",
                  "text": "Let us wait until the end to decide.",
                  "next": "closed"
                }
              ]
            },
            "opened": {
              "type": "end",
              "speaker": "locataire",
              "pose": "curious",
              "backplate": "default",
              "text": "A door can protect without being locked on both sides."
            },
            "closed": {
              "type": "end",
              "speaker": "locataire",
              "pose": "neutral",
              "backplate": "default",
              "text": "Then the end will decide for us."
            }
          }
        },
        {
          "id": "the_key",
          "title": "The Key",
          "start": "arrival",
          "nodes": {
            "arrival": {
              "type": "line",
              "speaker": "locataire",
              "pose": "neutral",
              "backplate": "default",
              "text": "When the circle reaches both houses, who will have to leave?",
              "next": "reply"
            },
            "reply": {
              "type": "line",
              "speaker": "monsieur",
              "pose": "worried",
              "backplate": "default",
              "text": "I no longer want “us” to need an outside.",
              "next": "answer"
            },
            "answer": {
              "type": "choice",
              "speaker": "monsieur",
              "pose": "worried",
              "backplate": "default",
              "text": "What do you do with the key?",
              "choices": [
                {
                  "id": "invite",
                  "text": "The door will open both ways.",
                  "next": "invited",
                  "effects": [
                    {
                      "type": "set",
                      "key": "invitation",
                      "value": true
                    }
                  ]
                },
                {
                  "id": "keep",
                  "text": "I will keep the key.",
                  "next": "kept"
                }
              ]
            },
            "invited": {
              "type": "end",
              "speaker": "locataire",
              "pose": "curious",
              "backplate": "default",
              "text": "I heard you. Let us see if the house can do the same."
            },
            "kept": {
              "type": "end",
              "speaker": "locataire",
              "pose": "hostile",
              "backplate": "default",
              "text": "A key can also lock in the person holding it."
            }
          }
        }
      ]
    },
