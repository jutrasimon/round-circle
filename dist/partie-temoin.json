  "endings": {
    "harmony": {
      "eyebrow": "LA PORTE S’OUVRE",
      "title": "Une maison commune",
      "text": "Le vortex cesse d’avancer. Monsieur demande : « Et si la maison n’avait jamais été à nous ? » La Locataire répond : « Elle n’était pas à nous non plus. Elle peut peut-être nous garder tous. »",
      "requiredFlags": [
        "listened",
        "passage",
        "invitation"
      ],
      "minBuildings": 1
    },
    "force": {
      "eyebrow": "LE CERCLE SE TAIT",
      "title": "Une victoire vide",
      "text": "Il ne reste personne pour contester le titre. La maison n’a jamais paru si vide.",
      "waveId": "threshold"
    },
    "departure": {
      "eyebrow": "LE CERCLE SE REFERME",
      "title": "Vers une autre maison",
      "text": "Le train part avec ce qu’il peut porter. Derrière lui, une fenêtre s’allume. Le mot « maison » change d’habitant sans changer d’adresse."
    },
    "defeat": {
      "eyebrow": "LE TRAIN S’ARRÊTE",
      "title": "Le convoi perdu",
      "text": "Les maisons gardent leurs lumières allumées pour un train qui ne revient pas."
    }
  }
