  "endings": {
    "harmony": {
      "eyebrow": "THE DOOR OPENS",
      "title": "A Home Together",
      "text": "The vortex stops growing. The Gentleman asks: “What if the house was never ours?” The Tenant replies: “It was never ours either. Perhaps it can hold all of us.”",
      "requiredFlags": [
        "listened",
        "passage",
        "invitation"
      ],
      "minBuildings": 1
    },
    "force": {
      "eyebrow": "THE CIRCLE FALLS SILENT",
      "title": "An Empty Victory",
      "text": "No one remains to dispute the deed. The house has never felt so empty.",
      "waveId": "threshold"
    },
    "departure": {
      "eyebrow": "THE CIRCLE CLOSES",
      "title": "Towards Another Home",
      "text": "The train leaves with all it can carry. Behind it, a window lights up. The word “home” changes inhabitants without changing its address."
    },
    "defeat": {
      "eyebrow": "THE TRAIN STOPS",
      "title": "The Lost Convoy",
      "text": "The houses leave their lights on for a train that never returns."
    }
  },
