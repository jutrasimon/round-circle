      "dialogues": [
        {
          "id": "the_line",
          "title": "Le trait",
          "start": "arrival",
          "nodes": {
            "arrival": {
              "type": "line",
              "speaker": "locataire",
              "pose": "neutral",
              "backplate": "default",
              "text": "Vous avez tracé un cercle, puis écrit « chez nous » à l’intérieur.",
              "next": "reply"
            },
            "reply": {
              "type": "line",
              "speaker": "monsieur",
              "pose": "neutral",
              "backplate": "default",
              "text": "Nous voulions un endroit où rentrer.",
              "next": "answer"
            },
            "answer": {
              "type": "choice",
              "speaker": "monsieur",
              "pose": "worried",
              "backplate": "default",
              "text": "La Locataire vous regarde.",
              "choices": [
                {
                  "id": "listen",
                  "text": "Montrez-moi ce que le trait a coupé.",
                  "next": "listened",
                  "effects": [
                    {
                      "type": "set",
                      "key": "listened",
                      "value": true
                    }
                  ]
                },
                {
                  "id": "claim",
                  "text": "Les murs prouvent que nous sommes chez nous.",
                  "next": "claimed",
                  "effects": [
                    {
                      "type": "add",
                      "key": "tension",
                      "value": 1
                    }
                  ]
                }
              ]
            },
            "listened": {
              "type": "end",
              "speaker": "locataire",
              "pose": "curious",
              "backplate": "default",
              "text": "Nous aussi, nous voulions rentrer."
            },
            "claimed": {
              "type": "end",
              "speaker": "locataire",
              "pose": "hostile",
              "backplate": "default",
              "text": "Un mur prouve seulement qu’on a cessé de regarder derrière."
            }
          }
        },
        {
          "id": "the_passage",
          "title": "Le passage",
          "start": "arrival",
          "nodes": {
            "arrival": {
              "type": "line",
              "speaker": "locataire",
              "pose": "neutral",
              "backplate": "default",
              "text": "Vos maisons ont des murs. Les nôtres avaient des passages.",
              "next": "reply"
            },
            "reply": {
              "type": "line",
              "speaker": "monsieur",
              "pose": "worried",
              "backplate": "default",
              "text": "Si j’ouvre un passage, qui protège ceux qui sont derrière moi ?",
              "next": "answer"
            },
            "answer": {
              "type": "choice",
              "speaker": "monsieur",
              "pose": "worried",
              "backplate": "default",
              "text": "La porte reste devant vous.",
              "choices": [
                {
                  "id": "passage",
                  "text": "Gardons un passage entre nous.",
                  "next": "opened",
                  "effects": [
                    {
                      "type": "set",
                      "key": "passage",
                      "value": true
                    }
                  ]
                },
                {
                  "id": "wait",
                  "text": "Attendons la fin pour décider.",
                  "next": "closed"
                }
              ]
            },
            "opened": {
              "type": "end",
              "speaker": "locataire",
              "pose": "curious",
              "backplate": "default",
              "text": "Une porte peut protéger sans être fermée des deux côtés."
            },
            "closed": {
              "type": "end",
              "speaker": "locataire",
              "pose": "neutral",
              "backplate": "default",
              "text": "Alors la fin décidera pour nous."
            }
          }
        },
        {
          "id": "the_key",
          "title": "La clé",
          "start": "arrival",
          "nodes": {
            "arrival": {
              "type": "line",
              "speaker": "locataire",
              "pose": "neutral",
              "backplate": "default",
              "text": "Quand le cercle touchera les deux maisons, qui devra partir ?",
              "next": "reply"
            },
            "reply": {
              "type": "line",
              "speaker": "monsieur",
              "pose": "worried",
              "backplate": "default",
              "text": "Je ne veux plus que le mot « nous » ait besoin d’un dehors.",
              "next": "answer"
            },
            "answer": {
              "type": "choice",
              "speaker": "monsieur",
              "pose": "worried",
              "backplate": "default",
              "text": "Que faites-vous de la clé ?",
              "choices": [
                {
                  "id": "invite",
                  "text": "La porte s’ouvrira dans les deux sens.",
                  "next": "invited",
                  "effects": [
                    {
                      "type": "set",
                      "key": "invitation",
                      "value": true
                    }
                  ]
                },
                {
                  "id": "keep",
                  "text": "Je garderai la clé.",
                  "next": "kept"
                }
              ]
            },
            "invited": {
              "type": "end",
              "speaker": "locataire",
              "pose": "curious",
              "backplate": "default",
              "text": "Je vous ai entendu. Voyons si la maison peut en faire autant."
            },
            "kept": {
              "type": "end",
              "speaker": "locataire",
              "pose": "hostile",
              "backplate": "default",
              "text": "Une clé peut aussi fermer celui qui la tient."
            }
          }
        }
      ]
    },
