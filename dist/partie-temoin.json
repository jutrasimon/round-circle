  "endings": {
    "harmony": {
      "eyebrow": "THE DOOR OPENS",
      "title": "A Home Together",
      "text": "The vortex stops growing. The Gentleman asks: “What if the house was never ours?” The Tenant replies: “It was never ours either. Perhaps it can hold all of us.”",
      "requiredFlags": [
        "listened",
        "passage",
        "invitation"
      ],
      "minBuildings": 1
    },
    "force": {
      "eyebrow": "FIVE MINUTES · FINAL WAVE DEFEATED",
      "title": "You Held the Line",
      "text": "You survived five minutes and defeated the final wave. The vortex still takes the city, but the convoy endured. This is a hard-earned survival victory; a shared home is another kind of triumph.",
