{
  "version": 1,
  "characters": {
    "monsieur": {
      "name": "YOU · THE GENTLEMAN",
      "role": "player",
      "poses": {
        "neutral": "assets/portraits/monsieur-neutral.png",
        "satisfied": "assets/portraits/monsieur-satisfied.png",
        "worried": "assets/portraits/monsieur-worried.png"
      }
    },
    "locataire": {
      "name": "THE TENANT",
      "role": "npc",
      "poses": {
        "neutral": "assets/portraits/locataire-neutral.png",
        "hostile": "assets/portraits/locataire-hostile.png",
        "curious": "assets/portraits/locataire-curious.png"
      }
    }
  },
  "backplates": {
    "default": "assets/ui/backplate.svg"
  },
  "dialogues": [
    {
      "id": "first_contact",
      "title": "The Threshold of Ownership",
      "start": "arrival",
      "nodes": {
        "arrival": {
          "type": "line",
          "speaker": "locataire",
          "pose": "neutral",
          "backplate": "default",
          "text": "You call this your home. We call it an intrusion.",
          "next": "answer"
        },
        "answer": {
          "type": "choice",
          "speaker": "monsieur",
          "pose": "neutral",
          "backplate": "default",
          "text": "How do you respond?",
          "choices": [
            {
              "id": "papers",
              "text": "An intrusion? We have the paperwork.",
              "next": "proud",
              "effects": [
                {
                  "type": "add",
                  "key": "tension",
                  "value": 1
                }
              ]
            },
            {
              "id": "before",
              "text": "Who lived here before us?",
              "next": "curious",
              "effects": [
                {
                  "type": "set",
                  "key": "listened",
                  "value": true
                }
              ]
            },
            {
              "id": "drink",
              "text": "May I offer you a drink?",
              "next": "offer",
              "effects": [
                {
                  "type": "set",
                  "key": "offered_drink",
                  "value": true
                }
              ]
            }
          ]
        },
        "proud": {
          "type": "line",
          "speaker": "monsieur",
          "pose": "satisfied",
          "backplate": "default",
          "text": "Three signatures. Two stamps. A perfectly legitimate home.",
          "next": "angry"
        },
        "angry": {
          "type": "line",
          "speaker": "locataire",
          "pose": "hostile",
          "backplate": "default",
          "text": "You had the door sign. You should have asked those sleeping behind it.",
          "next": "unease"
        },
        "unease": {
          "type": "line",
          "speaker": "monsieur",
          "pose": "worried",
          "backplate": "default",
          "text": "The door… could sign?",
          "next": "second"
        },
        "curious": {
          "type": "line",
          "speaker": "locataire",
          "pose": "curious",
          "backplate": "default",
          "text": "My mother. Then her mother. Then something we both called our mother.",
          "next": "second",
          "effects": [
            {
              "type": "add",
              "key": "trust",
              "value": 1
            }
          ]
        },
        "offer": {
          "type": "line",
          "speaker": "monsieur",
          "pose": "satisfied",
          "backplate": "default",
          "text": "It is local. Well, the glass is local.",
          "next": "accept"
        },
        "accept": {
          "type": "line",
          "speaker": "locataire",
          "pose": "curious",
          "backplate": "default",
          "text": "Keep the glass. Pour the rest into the lock.",
          "next": "second",
          "effects": [
            {
              "type": "add",
              "key": "trust",
              "value": 1
            }
          ]
        },
        "second": {
          "type": "choice",
          "speaker": "monsieur",
          "pose": "worried",
          "backplate": "default",
          "text": "How do you continue?",
          "choices": [
            {
              "id": "listen",
              "text": "Then tell me what an invitation would look like.",
              "next": "invitation",
              "effects": [
                {
                  "type": "add",
                  "key": "trust",
                  "value": 1
                }
              ]
            },
            {
              "id": "defend",
              "text": "I cannot abandon the people who live here.",
              "next": "inhabitants"
            },
            {
              "id": "mother",
              "text": "Would your mother like to meet us?",
              "next": "mother",
              "when": {
                "key": "listened",
                "op": "eq",
                "value": true
              }
            }
          ]
        },
        "invitation": {
          "type": "line",
          "speaker": "locataire",
          "pose": "curious",
          "backplate": "default",
          "text": "A place at the table. Not a deed.",
          "next": "end-peace"
        },
        "inhabitants": {
          "type": "line",
          "speaker": "locataire",
          "pose": "neutral",
          "backplate": "default",
          "text": "Neither can I. At last, something you understand.",
          "next": "end-tense"
        },
        "mother": {
          "type": "line",
          "speaker": "locataire",
          "pose": "curious",
          "backplate": "default",
          "text": "She is already meeting you. Why do you think the ground is breathing?",
          "next": "end-peace"
        },
        "end-peace": {
          "type": "end",
          "speaker": "monsieur",
          "pose": "worried",
          "backplate": "default",
          "text": "We will need a bigger table.",
          "effects": [
            {
              "type": "set",
              "key": "door_open",
              "value": true
            },
            {
              "type": "emit",
              "name": "dialogue_outcome",
              "payload": {
                "outcome": "invitation"
              }
            }
          ]
        },
        "end-tense": {
          "type": "end",
          "speaker": "monsieur",
          "pose": "neutral",
          "backplate": "default",
          "text": "We will discuss this… shared boundary again.",
          "effects": [
            {
              "type": "emit",
              "name": "dialogue_outcome",
              "payload": {
                "outcome": "stalemate"
              }
            }
          ]
        }
      }
    }
  ]
}
